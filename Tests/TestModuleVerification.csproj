<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputPath>..\bin\Debug\net48\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>TestModuleVerification</AssemblyName>
    <StartupObject>LushCareTests.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="TestDangBaiSuite.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="LushCare">
      <HintPath Condition="'$(LushCareAssemblyPath)' == ''">..\bin\Debug\net48\LushCare.exe</HintPath>
      <HintPath Condition="'$(LushCareAssemblyPath)' != ''">$(LushCareAssemblyPath)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>